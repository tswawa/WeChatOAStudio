{
  "name": "wechatoastudio",
  "private": true,
  "version": "0.3.14",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "WeChat Official Account intelligent operations assistant",
  "author": "tswawa",
  "homepage": "https://github.com/tswawa/WeChatOAStudio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:installer": "npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps",
    "test:desktop": "node scripts/test-desktop.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@extractus/feed-extractor": "^8.0.3",
    "@google/genai": "^3.0.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "13.0.3",
    "dompurify": "^3.4.17",
    "image-size": "^2.1.0",
    "ipaddr.js": "^2.5.0",
    "js-tiktoken": "^1.0.21",
    "juice": "^12.2.1",
    "linkedom": "^0.18.15",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "openai": "^7.47.0",
    "parse-srcset": "1.0.2",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "undici": "^8.12.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "weui": "^2.6.26",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "build": {
    "appId": "local.mp-ops.desktop",
    "productName": "WeChatOAStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "!electron/**/__pycache__/**/*",
      "!electron/**/*.pyc",
      "package.json",
      "!**/*.vcxproj",
      "!**/*.vcxproj.filters",
      "!**/*.sln",
      "!**/*.pdb",
      "!**/*.obj",
      "!**/*.lib",
      "!**/*.exp",
      "!**/*.recipe",
      "!**/*.lastbuildstate",
      "!**/*.tlog",
      "!**/build/config.gypi",
      "!**/build/Release/obj/**",
      "!**/build/Release/test_extension.node"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "icon": "build/wechat-oa-copilot.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "WeChatOAStudio-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.WeChatOAStudio.txt"
      },
      {
        "from": "LICENSING.md",
        "to": "LICENSING.md"
      },
      {
        "from": "docs/THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "docs/third-party-licenses",
        "to": "third-party-licenses"
      }
    ]
  },
  "license": "GPL-3.0-only"
}
